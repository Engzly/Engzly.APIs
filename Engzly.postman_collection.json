            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Deliver groceries from Carrefour to Zamalek\",\n  \"description\": \"Medium shopping cart, two bags, ground floor pickup and fifth floor delivery.\",\n  \"number_of_taskers_needed\": 1,\n  \"top_k\": 5,\n  \"category_id\": \"delivery\",\n  \"category_name\": \"Delivery\",\n  \"currency\": \"EGP\",\n  \"exemplars\": [\n    { \"title\": \"Pick up groceries from Gourmet and drop in Maadi\", \"description\": \"Three bags, evening drop, tip included.\", \"budget\": 180, \"duration_minutes\": 90 },\n    { \"title\": \"Deliver online order from Amazon locker to apartment\", \"description\": \"Small box, morning pickup.\", \"budget\": 120, \"duration_minutes\": 60 },\n    { \"title\": \"Bring Spinneys weekly shop upstairs\", \"description\": \"Six bags, fourth floor no elevator, weekend.\", \"budget\": 250, \"duration_minutes\": 120 },\n    { \"title\": \"Carrefour City to New Cairo delivery\", \"description\": \"Four bags including dairy and frozen items.\", \"budget\": 220, \"duration_minutes\": 100 },\n    { \"title\": \"Pharmacy run and home delivery\", \"description\": \"Prescription plus two OTC items.\", \"budget\": 80, \"duration_minutes\": 45 }\n  ]\n}"
            },
            "description": "Direct call to the Python AI service. Sends the task plus a set of historical exemplars (title, description, budget, duration_minutes). The service embeds everything with sentence-transformers/all-MiniLM-L6-v2, runs k-NN cosine-similarity regression on the exemplars, and returns a cost + duration estimate with confidence based on neighbor similarity. With an empty exemplars array it degrades to a complexity-factor heuristic."
